@model SkillDetailsViewModel
@{
    var o = Model.Offer;
    ViewData["Title"] = o.Title;
}

<a asp-action="Index" class="small">← All skills</a>
<div class="row g-4 mt-1">
    <div class="col-lg-8">
        <div class="ss-card">
            <div class="d-flex flex-wrap gap-2 mb-3">
                <span class="tag">@o.Category?.Icon @o.Category?.Name</span>
                <span class="tag tag-muted">@o.Level</span>
                <span class="tag tag-muted">@(o.Mode == SessionMode.InPerson ? "In person" : "Online")</span>
                @if (!o.IsActive) { <span class="tag tag-accent">Paused</span> }
            </div>
            <h1 class="h3">@o.Title</h1>
            <p class="mt-3" style="white-space:pre-line">@o.Description</p>

            <hr />
            <div class="d-flex align-items-center gap-3">
                <partial name="_Avatar" model="o.Teacher!.FullName" view-data='new ViewDataDictionary(ViewData) { ["Size"] = "avatar-lg" }' />
                <div>
                    <div class="fw-bold">@o.Teacher.FullName</div>
                    <div class="small text-muted">@o.Teacher.Department</div>
                    @if (!string.IsNullOrEmpty(o.Teacher.Bio)) { <div class="small mt-1">@o.Teacher.Bio</div> }
                </div>
            </div>
        </div>

        <h2 class="h5 mt-4 mb-3">Reviews @if (Model.AverageRating.HasValue) { <span class="ms-2"><partial name="_Stars" model="Model.AverageRating" /> <span class="small text-muted">@Model.AverageRating.Value.ToString("0.0") (@Model.Reviews.Count)</span></span> }</h2>
        @if (!Model.Reviews.Any())
        {
            <p class="text-muted">No reviews yet.</p>
        }
        @foreach (var r in Model.Reviews)
        {
            <div class="ss-card mb-2 py-3">
                <div class="d-flex justify-content-between">
                    <span class="d-flex align-items-center gap-2"><partial name="_Avatar" model="r.Reviewer!.FullName" /> <strong>@r.Reviewer.FullName</strong></span>
                    <partial name="_Stars" model="(double?)r.Rating" />
                </div>
                @if (!string.IsNullOrEmpty(r.Comment)) { <p class="mb-0 mt-2">@r.Comment</p> }
                <div class="small text-muted mt-1">@r.CreatedAt.ToString("d MMM yyyy")</div>
            </div>
        }
    </div>

    <div class="col-lg-4">
        <div class="ss-card position-sticky" style="top:1rem">
            <div class="text-muted small">Session cost</div>
            <div class="h2 mb-0">@o.DurationHours credit@(o.DurationHours == 1 ? "" : "s")</div>
            <div class="small text-muted mb-3">for a @o.DurationHours-hour session</div>

            @if (Model.IsOwner)
            {
                <a asp-action="Edit" asp-route-id="@o.Id" class="btn btn-primary w-100 mb-2">Edit skill</a>
                <a asp-action="Delete" asp-route-id="@o.Id" class="btn btn-outline-danger w-100">Delete</a>
            }
            else if (!o.IsActive)
            {
                <button class="btn btn-secondary w-100" disabled>Not accepting requests</button>
            }
            else if (!Model.IsLoggedIn)
            {
                <a asp-controller="Account" asp-action="Login" asp-route-returnUrl="@Url.Action("Details", new { id = o.Id })" class="btn btn-primary w-100">Log in to book</a>
            }
            else
            {
                <a asp-controller="Bookings" asp-action="Create" asp-route-skillId="@o.Id" class="btn btn-primary w-100">Request a session</a>
                <div class="small text-muted mt-2 text-center">You have @Model.ViewerCredits credit@(Model.ViewerCredits == 1 ? "" : "s")</div>
            }
        </div>
    </div>
</div>
