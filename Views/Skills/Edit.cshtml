@model SkillOffer
@{ ViewData["Title"] = "Edit skill"; }

<div class="row justify-content-center">
    <div class="col-lg-7">
        <a asp-action="Details" asp-route-id="@Model.Id" class="small">← Back to skill</a>
        <div class="ss-card mt-2">
            <h1 class="h4 mb-4">Edit skill</h1>
            <form asp-action="Edit" asp-route-id="@Model.Id" method="post" novalidate>
                <partial name="_SkillForm" model="Model" />
                <div class="form-check form-switch mb-4">
                    <input asp-for="IsActive" class="form-check-input" role="switch" />
                    <label asp-for="IsActive" class="form-check-label"></label>
                </div>
                <div class="d-flex gap-2">
                    <button type="submit" class="btn btn-primary">Save changes</button>
                    <a asp-action="Delete" asp-route-id="@Model.Id" class="btn btn-outline-danger ms-auto">Delete</a>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts { <partial name="_ValidationScriptsPartial" /> }
