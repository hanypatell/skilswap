@model SkillOffer
@{ ViewData["Title"] = "Offer a skill"; }

<div class="row justify-content-center">
    <div class="col-lg-7">
        <a asp-action="Mine" class="small">← My skills</a>
        <div class="ss-card mt-2">
            <h1 class="h4 mb-1">Offer a skill</h1>
            <p class="text-muted small mb-4">Every hour you teach earns you 1 credit to spend on learning.</p>
            <form asp-action="Create" method="post" novalidate>
                <partial name="_SkillForm" model="Model" />
                <button type="submit" class="btn btn-primary mt-2">Publish skill</button>
            </form>
        </div>
    </div>
</div>

@section Scripts { <partial name="_ValidationScriptsPartial" /> }
