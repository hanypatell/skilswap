@model BookingsViewModel
@{
    ViewData["Title"] = "My sessions";
    var waiting = Model.AsTeacher.Count(b => b.Status == BookingStatus.Pending);
}

<h1 class="h3 mb-4">My sessions</h1>

<ul class="nav nav-tabs mb-3" role="tablist">
    <li class="nav-item" role="presentation">
        <button class="nav-link active" data-bs-toggle="tab" data-bs-target="#learning" type="button" role="tab">Learning (@Model.AsLearner.Count)</button>
    </li>
    <li class="nav-item" role="presentation">
        <button class="nav-link" data-bs-toggle="tab" data-bs-target="#teaching" type="button" role="tab">
            Teaching (@Model.AsTeacher.Count)
            @if (waiting > 0) { <span class="badge rounded-pill" style="background:var(--ss-accent)">@waiting new</span> }
        </button>
    </li>
</ul>

<div class="tab-content">
    <div class="tab-pane fade show active" id="learning" role="tabpanel">
        @if (!Model.AsLearner.Any())
        {
            <div class="ss-card empty-state"><div class="big">📚</div><p>You haven't booked any sessions yet.</p><a asp-controller="Skills" asp-action="Index" class="btn btn-primary">Find a skill</a></div>
        }
        @foreach (var b in Model.AsLearner)
        {
            <partial name="_BookingRow" model="b" view-data='new ViewDataDictionary(ViewData) { ["AsTeacher"] = false }' />
        }
    </div>
    <div class="tab-pane fade" id="teaching" role="tabpanel">
        @if (!Model.AsTeacher.Any())
        {
            <div class="ss-card empty-state"><div class="big">🎓</div><p>No one has booked you yet. Offer a skill to start earning.</p><a asp-controller="Skills" asp-action="Create" class="btn btn-primary">Offer a skill</a></div>
        }
        @foreach (var b in Model.AsTeacher)
        {
            <partial name="_BookingRow" model="b" view-data='new ViewDataDictionary(ViewData) { ["AsTeacher"] = true }' />
        }
    </div>
</div>

@section Scripts {
<script>
    // Open the Teaching tab directly when linked with #teaching
    if (location.hash === '#teaching') bootstrap.Tab.getOrCreateInstance(document.querySelector('[data-bs-target="#teaching"]')).show();
</script>
}
