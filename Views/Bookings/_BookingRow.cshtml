@model Booking
@{
    var asTeacher = (bool)ViewData["AsTeacher"]!;
    var other = asTeacher ? Model.Learner! : Model.Teacher!;
}
<div class="booking-row">
    <div class="d-flex flex-wrap justify-content-between gap-3">
        <div class="d-flex gap-3">
            <partial name="_Avatar" model="other.FullName" />
            <div>
                <a asp-controller="Skills" asp-action="Details" asp-route-id="@Model.SkillOfferId" class="fw-bold text-decoration-none">@Model.SkillOffer!.Title</a>
                <div class="small text-muted">@(asTeacher ? "Learner" : "Teacher"): @other.FullName · @Model.Hours credit@(Model.Hours == 1 ? "" : "s")</div>
                <div class="small">📅 @Model.ScheduledAt.ToString("ddd, d MMM yyyy · h:mm tt")</div>
                @if (!string.IsNullOrEmpty(Model.Message))
                {
                    <div class="small text-muted fst-italic mt-1">"@Model.Message"</div>
                }
            </div>
        </div>
        <div class="d-flex flex-column align-items-end gap-2">
            <partial name="_StatusBadge" model="Model.Status" />
            <div class="d-flex flex-wrap gap-2 justify-content-end">
                @if (asTeacher && Model.Status == BookingStatus.Pending)
                {
                    <form asp-action="Accept" asp-route-id="@Model.Id" method="post"><button class="btn btn-sm btn-primary">Accept</button></form>
                    <form asp-action="Decline" asp-route-id="@Model.Id" method="post"><button class="btn btn-sm btn-outline-danger">Decline</button></form>
                }
                @if (!asTeacher && Model.Status == BookingStatus.Accepted)
                {
                    <form asp-action="Complete" asp-route-id="@Model.Id" method="post"><button class="btn btn-sm btn-primary">Mark as done</button></form>
                }
                @if (!asTeacher && (Model.Status == BookingStatus.Pending || Model.Status == BookingStatus.Accepted))
                {
                    <form asp-action="Cancel" asp-route-id="@Model.Id" method="post" onsubmit="return confirm('Cancel this session? Your credits will be refunded.')"><button class="btn btn-sm btn-outline-secondary">Cancel</button></form>
                }
                @if (!asTeacher && Model.Status == BookingStatus.Completed && Model.Review == null)
                {
                    <a asp-action="Review" asp-route-id="@Model.Id" class="btn btn-sm btn-outline-primary">Leave a review</a>
                }
                @if (Model.Review != null)
                {
                    <partial name="_Stars" model="(double?)Model.Review.Rating" />
                }
            </div>
        </div>
    </div>
</div>
